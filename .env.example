# ============================================
# CONTOH file environment variable (.env)
# ============================================
# Salin file ini jadi ".env" (tanpa ".example") lalu isi dengan nilai asli.
# File ".env" JANGAN pernah di-commit ke GitHub (sudah otomatis di-ignore lewat .gitignore).

# --- Database (Neon Postgres - gratis) ---
# Didapat dari dashboard Neon setelah bikin project (Tahap selanjutnya)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Autentikasi ---
# String rahasia buat menandatangani "tiket sesi login" (JWT).
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-yang-panjang"

# --- Akun admin pertama (dipakai sekali oleh prisma/seed-admin.ts) ---
# Jalankan: npx tsx prisma/seed-admin.ts
# Setelah berhasil login pertama kali, SEBAIKNYA ganti password ini.
ADMIN_EMAIL="admin@jogjakota.go.id"
ADMIN_PASSWORD="gantidengan-password-kuat-minimal8karakter"
ADMIN_NAMA="Admin Bakesbangpol"

# --- Email (Resend - gratis untuk volume kecil) ---
RESEND_API_KEY="re_xxxxxxxxxx"

# --- Google Apps Script (penyimpanan file PDF di Google Drive) ---
# URL Web App yang didapat setelah deploy Apps Script (Tahap selanjutnya)
GAS_WEBAPP_URL="https://script.google.com/macros/s/xxxxx/exec"
GAS_SHARED_SECRET="string-rahasia-untuk-verifikasi-request-ke-apps-script"

# --- Google reCAPTCHA (gratis) ---
RECAPTCHA_SITE_KEY="xxxxx"
RECAPTCHA_SECRET_KEY="xxxxx"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
